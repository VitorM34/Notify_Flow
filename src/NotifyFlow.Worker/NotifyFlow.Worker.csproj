    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-NotifyFlow.Worker-791bed8c-8d74-4888-8fd9-07b6ecf10fde</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
